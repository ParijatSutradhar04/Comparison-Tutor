<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Village goat - medium size -->
  <rect width="200" height="200" fill="#87CEEB"/>
  <!-- Body -->
  <ellipse cx="100" cy="130" rx="35" ry="20" fill="#FFFFFF"/>
  <!-- Head -->
  <ellipse cx="75" cy="110" rx="15" ry="12" fill="#FFFFFF"/>
  <!-- Legs -->
  <rect x="80" y="145" width="6" height="20" fill="#8B4513"/>
  <rect x="90" y="145" width="6" height="20" fill="#8B4513"/>
  <rect x="110" y="145" width="6" height="20" fill="#8B4513"/>
  <rect x="120" y="145" width="6" height="20" fill="#8B4513"/>
  <!-- Horns -->
  <polygon points="65,105 68,95 71,105" fill="#8B4513"/>
  <polygon points="79,105 82,95 85,105" fill="#8B4513"/>
  <!-- Tail -->
  <path d="M135 135 Q140 140 138 145" stroke="#8B4513" stroke-width="3" fill="none"/>
  <!-- Beard -->
  <ellipse cx="70" cy="118" rx="3" ry="8" fill="#FFFFFF"/>
  <text x="100" y="190" text-anchor="middle" fill="#000" font-size="12">Medium Village Goat</text>
</svg>
