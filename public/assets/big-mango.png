<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Big mango - large fruit -->
  <rect width="200" height="200" fill="#87CEEB"/>
  <!-- Mango shape -->
  <ellipse cx="100" cy="100" rx="40" ry="55" fill="#FFD700"/>
  <!-- Highlight -->
  <ellipse cx="85" cy="80" rx="12" ry="18" fill="#FFF8DC" opacity="0.7"/>
  <!-- Stem -->
  <rect x="98" y="45" width="4" height="10" fill="#228B22"/>
  <!-- Leaf -->
  <ellipse cx="105" cy="50" rx="8" ry="3" fill="#32CD32"/>
  <text x="100" y="180" text-anchor="middle" fill="#000" font-size="12">Large Mango</text>
</svg>
