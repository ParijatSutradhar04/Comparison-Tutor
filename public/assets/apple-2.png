<svg width="300" height="300" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="300" height="300" fill="#fef3c7"/>
  <text x="150" y="30" text-anchor="middle" font-size="18" font-weight="bold" fill="#92400e">2 Apples</text>
  
  <!-- 2 apples side by side -->
  <circle cx="110" cy="120" r="35" fill="#ef4444" opacity="0.9"/>
  <circle cx="190" cy="120" r="35" fill="#ef4444" opacity="0.9"/>
  
  <!-- Apple stems -->
  <line x1="110" y1="85" x2="110" y2="100" stroke="#22c55e" stroke-width="4"/>
  <line x1="190" y1="85" x2="190" y2="100" stroke="#22c55e" stroke-width="4"/>
  
  <!-- Apple leaves -->
  <ellipse cx="105" cy="85" rx="8" ry="4" fill="#22c55e" opacity="0.8"/>
  <ellipse cx="185" cy="85" rx="8" ry="4" fill="#22c55e" opacity="0.8"/>
  
  <text x="150" y="220" text-anchor="middle" font-size="20" font-weight="bold" fill="#92400e">2 Apples</text>
  <text x="150" y="250" text-anchor="middle" font-size="16" fill="#6b7280">Right Side - Fewer Apples</text>
</svg>
