<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Tulsi plant - small, bushy -->
  <rect width="200" height="200" fill="#87CEEB"/>
  <!-- Pot -->
  <rect x="75" y="150" width="50" height="30" fill="#8B4513" rx="5"/>
  <!-- Small stem -->
  <rect x="98" y="130" width="4" height="20" fill="#228B22"/>
  <!-- Small leaves -->
  <ellipse cx="90" cy="125" rx="8" ry="12" fill="#32CD32"/>
  <ellipse cx="110" cy="128" rx="10" ry="15" fill="#32CD32"/>
  <ellipse cx="100" cy="110" rx="6" ry="10" fill="#32CD32"/>
  <!-- Flowers -->
  <circle cx="95" cy="115" r="2" fill="#9932CC"/>
  <circle cx="105" cy="120" r="2" fill="#9932CC"/>
  <text x="100" y="190" text-anchor="middle" fill="#000" font-size="12">Small Tulsi Plant</text>
</svg>
