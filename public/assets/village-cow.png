<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <!-- Village cow - large -->
  <rect width="200" height="200" fill="#87CEEB"/>
  <!-- Body -->
  <ellipse cx="100" cy="120" rx="60" ry="30" fill="#F4A460"/>
  <!-- Head -->
  <ellipse cx="60" cy="90" rx="25" ry="20" fill="#F4A460"/>
  <!-- Legs -->
  <rect x="70" y="140" width="8" height="25" fill="#8B4513"/>
  <rect x="85" y="140" width="8" height="25" fill="#8B4513"/>
  <rect x="115" y="140" width="8" height="25" fill="#8B4513"/>
  <rect x="130" y="140" width="8" height="25" fill="#8B4513"/>
  <!-- Horns -->
  <polygon points="45,80 50,70 55,80" fill="#8B4513"/>
  <polygon points="65,80 70,70 75,80" fill="#8B4513"/>
  <!-- Tail -->
  <path d="M160 130 Q170 140 165 150" stroke="#8B4513" stroke-width="4" fill="none"/>
  <!-- Udder -->
  <ellipse cx="110" cy="145" rx="15" ry="8" fill="#FFB6C1"/>
  <text x="100" y="190" text-anchor="middle" fill="#000" font-size="12">Large Village Cow</text>
</svg>
